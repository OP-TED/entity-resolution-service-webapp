# Backend curation API address (host:port, without protocol prefix)
# Nginx prepends 'http://' internally when proxying API requests.
# Use 'curation-api:8000' when running in Docker (shared ersys-local network).
# Use 'localhost:8000' when running the Webapp outside Docker (npm run dev).
API_BACKEND_URL=curation-api:8000

# Score levels
# Confidence and similarity share one three-level scale (Low / Medium / High).
# the boundaries between the ranges are configurable here.
#
# Ranges are contiguous: Low is 0..LOW_MAX, Medium is LOW_MAX..MEDIUM_MAX, High
# is MEDIUM_MAX..1.0 — which is why High needs no maximum. Set values that
# satisfy 0 < LOW_MAX < MEDIUM_MAX < 1;
SCORE_LEVEL_LOW_MAX=0.4
SCORE_LEVEL_MEDIUM_MAX=0.7